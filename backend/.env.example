# AI provider: "gemini" or "claude". If unset, whichever key below is present
# is used (Claude first). With no key at all, the app runs on demo data.
LLM_PROVIDER=gemini

# Gemini — free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key
# GEMINI_MODEL=gemini-3.5-flash

# Claude — paid key from https://console.anthropic.com
# ANTHROPIC_API_KEY=your-anthropic-key
# CLAUDE_MODEL=claude-sonnet-5

# Gmail SMTP (App Password from https://myaccount.google.com/apppasswords)
SMTP_USER=you@gmail.com
SMTP_APP_PASSWORD=your-16-char-app-password
